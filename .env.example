# SideDoor environment variables
# Copy to .env (local dev) and fill in. For staging/production, set these in Railway.

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_URL=http://localhost:5000
PORT=5000

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────
# Use sk_test_ in dev/staging, sk_live_ in production.
# Production startup will refuse to boot with a non-live key.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Set BILLING_ENABLED=false to short-circuit checkout/portal/change-plan
# endpoints (returns 503). Useful as an emergency kill switch.
BILLING_ENABLED=true

# Stripe price IDs — create in Stripe Dashboard → Products, then paste here.
# All 12 must be set; startup validation fails in production if any are missing.
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_3MONTH_PRICE_ID=price_...
STRIPE_STARTER_6MONTH_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_3MONTH_PRICE_ID=price_...
STRIPE_PRO_6MONTH_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_MAX_MONTHLY_PRICE_ID=price_...
STRIPE_MAX_3MONTH_PRICE_ID=price_...
STRIPE_MAX_6MONTH_PRICE_ID=price_...
STRIPE_MAX_ANNUAL_PRICE_ID=price_...

# ── Database (direct Postgres, used by drizzle migrations) ───────────
DATABASE_URL=
POSTGRES_CONNECTION_STRING=

# ── Auth / Sessions ──────────────────────────────────────────────────
SESSION_SECRET=
ISSUER_URL=                  # OIDC issuer (Replit auth)
REPLIT_DOMAINS=              # Replit auth allowlist (legacy)
REPL_ID=                     # Replit auth client ID (legacy)

# ── AI / External APIs ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APOLLO_API_KEY=

# ── Email (sending) ──────────────────────────────────────────────────
EMAIL_PROVIDER=              # "resend" | "sendgrid"
EMAIL_FROM=
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── Email enrichment / verification ──────────────────────────────────
HUNTER_API_KEY=
NEVERBOUNCE_API_KEY=
ZEROBOUNCE_API_KEY=
